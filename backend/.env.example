# Puerto del backend local
PORT=4000

# "real" = llama a la API del SII ITC | "mock" = usa datos ficticios (desarrollo / demo de respaldo)
SII_MODE=real
SII_BASE_URL=https://sii.celaya.tecnm.mx/api

# Dominio institucional para armar el correo cuando el alumno escribe solo su número de control
SII_EMAIL_DOMAIN=celaya.tecnm.mx

# Origen del frontend en desarrollo (Vite). En producción se usa el rewrite de Vercel y no hace falta.
FRONTEND_ORIGIN=http://localhost:5173

# production activa cookies Secure
NODE_ENV=development

# ---------- Planificador ----------
# Neon (PostgreSQL). Si lo dejas vacío, se usa PGlite: una BD local dentro de backend/.pglite (no instalas nada)
DATABASE_URL=
# Especialidad a usar si no se detecta por el kardex
ESPECIALIDAD_POR_DEFECTO=ISIE-IDP-2025-01

# ---------- Panel de administración ----------
# En desarrollo, si no los defines: admin / admin123. En producción son OBLIGATORIOS.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# Cadena larga y aleatoria para firmar la cookie de admin (en Render usa "Generate")
ADMIN_SECRET=cambia-esto-por-algo-largo-y-aleatorio
