# Puerto del backend local
PORT=4000

# "real" = llama a la API del SII ITC | "mock" = usa datos ficticios (desarrollo / demo de respaldo)
SII_MODE=real
SII_BASE_URL=https://sii.celaya.tecnm.mx/api

# Dominio institucional para armar el correo cuando el alumno escribe solo su número de control
SII_EMAIL_DOMAIN=celaya.tecnm.mx

# Origen del frontend en desarrollo (Vite). En producción se usa el rewrite de Vercel y no hace falta.
FRONTEND_ORIGIN=http://localhost:5173

# production activa cookies Secure
NODE_ENV=development
